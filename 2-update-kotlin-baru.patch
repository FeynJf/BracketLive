+package com.gamebracket.overlay
+
+import android.content.ContentValues
+import android.graphics.Bitmap
+import android.graphics.Color
+import android.graphics.Typeface
+import android.net.Uri
+import android.os.Build
+import android.os.Bundle
+import android.os.Environment
+import android.os.Handler
+import android.os.Looper
+import android.provider.MediaStore
+import android.text.Editable
+import android.text.TextWatcher
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.EditText
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.TextView
+import android.widget.Toast
+import androidx.activity.result.contract.ActivityResultContracts
+import androidx.appcompat.app.AppCompatActivity
+import androidx.core.content.ContextCompat
+import java.io.File
+import java.io.FileOutputStream
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/** Editor sertifikat: ubah teks, logo, dan tema dengan pratinjau langsung, lalu simpan ke Galeri. */
+class CertificateActivity : AppCompatActivity() {
+
+    private lateinit var ivPreview: ImageView
+    private lateinit var form: LinearLayout
+    private val data = CertificateRenderer.Data()
+    private val handler = Handler(Looper.getMainLooper())
+    private var latest: Bitmap? = null
+    private var pickTarget: ((String) -> Unit)? = null
+    private lateinit var btnChampLogo: TextView
+    private lateinit var btnOrgLogo: TextView
+    private val themeButtons = mutableListOf<TextView>()
+
+    private val picker = registerForActivityResult(ActivityResultContracts.GetContent()) { uri: Uri? ->
+        if (uri == null) return@registerForActivityResult
+        val path = LogoHelper.saveFromUri(this, uri)
+        if (path == null) toast("Gambar tidak bisa dibaca") else pickTarget?.invoke(path)
+    }
+
+    private val refresh = Runnable {
+        latest = CertificateRenderer.render(this, data)
+        ivPreview.setImageBitmap(latest)
+    }
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setContentView(R.layout.activity_certificate)
+        ivPreview = findViewById(R.id.ivPreview)
+        form = findViewById(R.id.formContainer)
+
+        val game = BracketStore.gameId?.let { BracketStore.games[it]?.first } ?: ""
+        val mode = BracketStore.mode?.name ?: ""
+        data.name = BracketStore.champion() ?: ""
+        data.championLogo = BracketStore.championLogo()
+        data.event = listOf(game, mode).filter { it.isNotBlank() }.joinToString(" · ")
+        data.date = SimpleDateFormat("d MMMM yyyy", Locale("id")).format(Date())
+
+        findViewById<View>(R.id.btnBack).setOnClickListener { finish() }
+        findViewById<View>(R.id.btnSave).setOnClickListener { save() }
+
+        addField("JUDUL SERTIFIKAT", data.title) { data.title = it }
+        addField("NAMA JUARA", data.name) { data.name = it }
+        addField("PERINGKAT", data.ranking) { data.ranking = it }
+        addField("TURNAMEN / EVENT", data.event) { data.event = it }
+        addField("TANGGAL", data.date) { data.date = it }
+        addField("NAMA PANITIA (JADI TANDA TANGAN)", data.signer, "Ketik nama, otomatis jadi tanda tangan") { data.signer = it }
+        addField("JABATAN", data.signerRole) { data.signerRole = it }
+
+        addLabel("LOGO")
+        val logoRow = LinearLayout(this).apply { orientation = LinearLayout.HORIZONTAL }
+        btnChampLogo = smallButton("Logo juara") { pickTarget = { p -> data.championLogo = p; updateLogoButtons(); schedule() }; picker.launch("image/*") }
+        btnOrgLogo = smallButton("Logo penyelenggara") { pickTarget = { p -> data.orgLogo = p; updateLogoButtons(); schedule() }; picker.launch("image/*") }
+        logoRow.addView(btnChampLogo)
+        logoRow.addView(btnOrgLogo)
+        form.addView(logoRow)
+        val clearRow = LinearLayout(this).apply { orientation = LinearLayout.HORIZONTAL }
+        clearRow.addView(smallButton("Hapus logo juara") { data.championLogo = null; updateLogoButtons(); schedule() })
+        clearRow.addView(smallButton("Hapus logo penyelenggara") { data.orgLogo = null; updateLogoButtons(); schedule() })
+        form.addView(clearRow)
+        updateLogoButtons()
+
+        addLabel("TEMA")
+        val themeRow = LinearLayout(this).apply { orientation = LinearLayout.HORIZONTAL }
+        listOf("Neon Gamer" to CertificateRenderer.THEME_NEON, "Klasik Emas" to CertificateRenderer.THEME_CLASSIC).forEach { (label, t) ->
+            val b = smallButton(label) { data.theme = t; updateThemeButtons(); schedule() }
+            themeButtons.add(b)
+            themeRow.addView(b)
+        }
+        form.addView(themeRow)
+        updateThemeButtons()
+
+        refresh.run()
+    }
+
+    override fun onStart() {
+        super.onStart()
+        AppVisibility.onStart()
+    }
+
+    override fun onStop() {
+        AppVisibility.onStop()
+        super.onStop()
+    }
+
+    private fun schedule() {
+        handler.removeCallbacks(refresh)
+        handler.postDelayed(refresh, 120)
+    }
+
+    private fun updateLogoButtons() {
+        btnChampLogo.text = if (data.championLogo != null) "Logo juara ✓" else "Logo juara"
+        btnOrgLogo.text = if (data.orgLogo != null) "Logo penyelenggara ✓" else "Logo penyelenggara"
+    }
+
+    private fun updateThemeButtons() {
+        themeButtons.forEachIndexed { i, b ->
+            val on = data.theme == i
+            b.setBackgroundResource(if (on) R.drawable.bg_chip_active else R.drawable.bg_chip)
+            b.setTextColor(ContextCompat.getColor(this, if (on) R.color.on_accent else R.color.muted_light))
+        }
+    }
+
+    private fun addLabel(text: String) {
+        form.addView(TextView(this).apply {
+            this.text = text
+            setTextColor(ContextCompat.getColor(context, R.color.muted))
+            textSize = 10f
+            letterSpacing = 0.15f
+            setTypeface(null, Typeface.BOLD)
+            setPadding(dp(2), dp(14), 0, dp(6))
+        })
+    }
+
+    private fun addField(label: String, value: String, hintText: String = "", onChange: (String) -> Unit) {
+        addLabel(label)
+        form.addView(EditText(this).apply {
+            setText(value)
+            hint = hintText
+            setHintTextColor(ContextCompat.getColor(context, R.color.dim))
+            setTextColor(ContextCompat.getColor(context, R.color.text))
+            textSize = 14f
+            setSingleLine()
+            setPadding(dp(14), 0, dp(14), 0)
+            setBackgroundResource(R.drawable.bg_input)
+            layoutParams = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(46))
+            addTextChangedListener(object : TextWatcher {
+                override fun beforeTextChanged(s: CharSequence?, a: Int, b: Int, c: Int) {}
+                override fun onTextChanged(s: CharSequence?, a: Int, b: Int, c: Int) {}
+                override fun afterTextChanged(s: Editable?) { onChange(s?.toString() ?: ""); schedule() }
+            })
+        })
+    }
+
+    private fun smallButton(label: String, onClick: () -> Unit) = TextView(this).apply {
+        text = label
+        gravity = Gravity.CENTER
+        textSize = 12f
+        setTypeface(null, Typeface.BOLD)
+        setTextColor(ContextCompat.getColor(context, R.color.muted_light))
+        setBackgroundResource(R.drawable.bg_chip)
+        layoutParams = LinearLayout.LayoutParams(0, dp(42), 1f).apply { marginEnd = dp(8); topMargin = dp(6) }
+        setOnClickListener { onClick() }
+    }
+
+    private fun save() {
+        val bmp = CertificateRenderer.render(this, data)
+        val safe = data.name.ifBlank { "Juara" }.replace(Regex("[^A-Za-z0-9]+"), "_")
+        val fileName = "Sertifikat_${safe}_${System.currentTimeMillis() / 1000}.png"
+        try {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
+                val values = ContentValues().apply {
+                    put(MediaStore.MediaColumns.DISPLAY_NAME, fileName)
+                    put(MediaStore.MediaColumns.MIME_TYPE, "image/png")
+                    put(MediaStore.MediaColumns.RELATIVE_PATH, Environment.DIRECTORY_PICTURES + "/BracketLive")
+                    put(MediaStore.MediaColumns.IS_PENDING, 1)
+                }
+                val uri = contentResolver.insert(MediaStore.Images.Media.EXTERNAL_CONTENT_URI, values)
+                    ?: throw IllegalStateException("Tidak bisa membuat file")
+                contentResolver.openOutputStream(uri)?.use { bmp.compress(Bitmap.CompressFormat.PNG, 100, it) }
+                values.clear()
+                values.put(MediaStore.MediaColumns.IS_PENDING, 0)
+                contentResolver.update(uri, values, null, null)
+            } else {
+                val dir = Environment.getExternalStoragePublicDirectory(Environment.DIRECTORY_PICTURES)
+                val folder = File(dir, "BracketLive").apply { mkdirs() }
+                FileOutputStream(File(folder, fileName)).use { bmp.compress(Bitmap.CompressFormat.PNG, 100, it) }
+            }
+            toast("Sertifikat disimpan ke Galeri (Pictures/BracketLive)")
+        } catch (e: Exception) {
+            toast("Gagal simpan: ${e.message}")
+        }
+    }
+
+    private fun toast(m: String) = Toast.makeText(this, m, Toast.LENGTH_LONG).show()
+
+    private fun dp(v: Int) = (v * resources.displayMetrics.density).toInt()
+}
diff --git a/app/src/main/java/com/gamebracket/overlay/CertificateRenderer.kt b/app/src/main/java/com/gamebracket/overlay/CertificateRenderer.kt
new file mode 100644
index 0000000..905bd5f
--- /dev/null
+++ b/app/src/main/java/com/gamebracket/overlay/CertificateRenderer.kt
@@ -0,0 +1,195 @@
+package com.gamebracket.overlay
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.RectF
+import android.graphics.Shader
+import android.graphics.Typeface
+import androidx.core.content.ContextCompat
+
+/** Menggambar sertifikat 1200x850. Semua teks bisa diedit lewat [Data]. */
+object CertificateRenderer {
+
+    const val W = 1200
+    const val H = 850
+
+    const val THEME_NEON = 0
+    const val THEME_CLASSIC = 1
+
+    class Data(
+        var title: String = "SERTIFIKAT JUARA",
+        var name: String = "",
+        var ranking: String = "JUARA 1",
+        var event: String = "",
+        var date: String = "",
+        var signer: String = "",
+        var signerRole: String = "Ketua Panitia",
+        var championLogo: String? = null,
+        var orgLogo: String? = null,
+        var theme: Int = THEME_NEON
+    )
+
+    private class Palette(
+        val bg1: Int, val bg2: Int, val acc1: Int, val acc2: Int, val line: Int,
+        val title: Int, val text: Int, val name: Int, val gold: Int, val ink: Int, val serif: Boolean
+    )
+
+    private val neon = Palette(
+        Color.parseColor("#141C4A"), Color.parseColor("#05060F"),
+        Color.parseColor("#00E5FF"), Color.parseColor("#FF2E88"), Color.parseColor("#2A3560"),
+        Color.WHITE, Color.parseColor("#A9B4D4"), Color.WHITE, Color.parseColor("#FFC83D"),
+        Color.parseColor("#E8F1FF"), false
+    )
+    private val classic = Palette(
+        Color.parseColor("#FFFDF5"), Color.parseColor("#F1E7CC"),
+        Color.parseColor("#C9A227"), Color.parseColor("#8B6B14"), Color.parseColor("#B89B4A"),
+        Color.parseColor("#5C4A1F"), Color.parseColor("#6B5E40"), Color.parseColor("#1A1A1A"),
+        Color.parseColor("#A8841A"), Color.parseColor("#0D1B3D"), true
+    )
+
+    private var signFace: Typeface? = null
+
+    /** Font tanda tangan tegak bersambung (Sacramento). Cadangan: font cursive bawaan Android. */
+    private fun signatureFace(ctx: Context): Typeface {
+        signFace?.let { return it }
+        val tf = try {
+            Typeface.createFromAsset(ctx.assets, "fonts/Sacramento-Regular.ttf")
+        } catch (e: Exception) {
+            Typeface.create("cursive", Typeface.NORMAL)
+        }
+        signFace = tf
+        return tf
+    }
+
+    fun render(ctx: Context, d: Data): Bitmap {
+        val pal = if (d.theme == THEME_CLASSIC) classic else neon
+        val bmp = Bitmap.createBitmap(W, H, Bitmap.Config.ARGB_8888)
+        val c = Canvas(bmp)
+        val p = Paint(Paint.ANTI_ALIAS_FLAG)
+        val w = W.toFloat()
+        val h = H.toFloat()
+        val face = if (pal.serif) Typeface.SERIF else Typeface.SANS_SERIF
+
+        // latar
+        p.shader = LinearGradient(0f, 0f, w, h, pal.bg1, pal.bg2, Shader.TileMode.CLAMP)
+        c.drawRect(0f, 0f, w, h, p)
+        p.shader = null
+
+        // motif bracket samar di sudut
+        p.style = Paint.Style.STROKE
+        p.strokeWidth = 3f
+        p.color = withAlpha(pal.acc1, 28)
+        c.drawLines(floatArrayOf(60f, 650f, 130f, 650f, 130f, 650f, 130f, 720f, 60f, 720f, 130f, 720f, 130f, 685f, 200f, 685f), p)
+        c.drawLines(floatArrayOf(w - 60f, 430f, w - 130f, 430f, w - 130f, 430f, w - 130f, 500f, w - 60f, 500f, w - 130f, 500f, w - 130f, 465f, w - 200f, 465f), p)
+
+        // bingkai
+        p.strokeWidth = 6f
+        p.shader = LinearGradient(0f, 0f, w, h, pal.acc1, pal.acc2, Shader.TileMode.CLAMP)
+        c.drawRoundRect(RectF(24f, 24f, w - 24f, h - 24f), 28f, 28f, p)
+        p.shader = null
+        p.strokeWidth = 1.5f
+        p.color = pal.line
+        c.drawRoundRect(RectF(46f, 46f, w - 46f, h - 46f), 18f, 18f, p)
+        p.style = Paint.Style.FILL
+
+        // logo penyelenggara (kiri atas) & logo Bracket Live (kanan atas)
+        if (!d.orgLogo.isNullOrEmpty()) drawLogoRing(c, LogoHelper.circleBitmap("", d.orgLogo, 192), 140f, 140f, 48f, pal)
+        ContextCompat.getDrawable(ctx, R.drawable.ic_logo)?.let {
+            it.setBounds(W - 190, 92, W - 94, 188)
+            it.draw(c)
+        }
+
+        // judul
+        text(c, "BRACKET LIVE", 600f, 118f, 20f, pal.acc1, face, true, 0.45f)
+        fit(c, d.title.uppercase(), 600f, 205f, 62f, 760f, pal.title, face, true, 0.1f)
+        p.shader = LinearGradient(470f, 0f, 730f, 0f, pal.acc1, pal.acc2, Shader.TileMode.CLAMP)
+        c.drawRoundRect(RectF(470f, 228f, 730f, 233f), 3f, 3f, p)
+        p.shader = null
+
+        // logo juara
+        val champName = d.name.ifBlank { "?" }
+        val big = LogoHelper.circleBitmap(champName, d.championLogo, 280)
+        drawLogoRing(c, big, 600f, 335f, 72f, pal)
+
+        text(c, "diberikan kepada", 600f, 455f, 22f, pal.text, face, false, 0.08f)
+        fit(c, d.name.ifBlank { "—" }, 600f, 535f, 70f, 940f, pal.name, face, true, 0f)
+        p.shader = LinearGradient(250f, 0f, 950f, 0f, pal.acc1, pal.acc2, Shader.TileMode.CLAMP)
+        c.drawRoundRect(RectF(250f, 560f, 950f, 563f), 2f, 2f, p)
+        p.shader = null
+
+        fit(c, d.ranking.uppercase(), 600f, 620f, 34f, 900f, pal.gold, face, true, 0.15f)
+        fit(c, d.event, 600f, 662f, 24f, 900f, pal.text, face, false, 0.03f)
+
+        // blok tanggal (kiri) & tanda tangan (kanan)
+        text(c, d.date, 300f, 722f, 28f, pal.name, face, false, 0f)
+        line(c, 150f, 735f, 450f, 735f, pal)
+        text(c, "Tanggal", 300f, 772f, 18f, pal.text, face, false, 0.1f)
+
+        // tanda tangan: nama diketik → tampil tegak bersambung
+        val sig = d.signer.trim()
+        if (sig.isNotEmpty()) {
+            p.typeface = signatureFace(ctx)
+            p.color = pal.ink
+            p.textAlign = Paint.Align.CENTER
+            var size = 92f
+            p.textSize = size
+            while (p.measureText(sig) > 330f && size > 30f) { size -= 2f; p.textSize = size }
+            c.drawText(sig, 900f, 724f, p)
+        }
+        line(c, 750f, 735f, 1050f, 735f, pal)
+        text(c, sig.ifBlank { "Nama Panitia" }, 900f, 770f, 22f, pal.name, face, true, 0f)
+        text(c, d.signerRole, 900f, 796f, 17f, pal.text, face, false, 0.05f)
+
+        text(c, "dibuat dengan Bracket Live", 600f, 792f, 14f, withAlpha(pal.text, 170), face, false, 0.1f)
+        return bmp
+    }
+
+    private fun withAlpha(color: Int, a: Int) = Color.argb(a, Color.red(color), Color.green(color), Color.blue(color))
+
+    private fun line(c: Canvas, x1: Float, y1: Float, x2: Float, y2: Float, pal: Palette) {
+        val p = Paint(Paint.ANTI_ALIAS_FLAG)
+        p.strokeWidth = 2f
+        p.color = pal.line
+        c.drawLine(x1, y1, x2, y2, p)
+    }
+
+    private fun drawLogoRing(c: Canvas, bmp: Bitmap, cx: Float, cy: Float, r: Float, pal: Palette) {
+        val p = Paint(Paint.ANTI_ALIAS_FLAG)
+        // cincin neon
+        p.style = Paint.Style.STROKE
+        p.strokeWidth = 6f
+        p.shader = LinearGradient(cx - r, cy - r, cx + r, cy + r, pal.acc1, pal.acc2, Shader.TileMode.CLAMP)
+        c.drawCircle(cx, cy, r + 8f, p)
+        p.shader = null
+        p.style = Paint.Style.FILL
+        val dst = RectF(cx - r, cy - r, cx + r, cy + r)
+        c.drawBitmap(bmp, null, dst, Paint(Paint.ANTI_ALIAS_FLAG or Paint.FILTER_BITMAP_FLAG))
+    }
+
+    private fun text(c: Canvas, s: String, x: Float, y: Float, size: Float, color: Int, face: Typeface, bold: Boolean, spacing: Float) {
+        val p = Paint(Paint.ANTI_ALIAS_FLAG)
+        p.color = color
+        p.textSize = size
+        p.textAlign = Paint.Align.CENTER
+        p.typeface = Typeface.create(face, if (bold) Typeface.BOLD else Typeface.NORMAL)
+        p.letterSpacing = spacing
+        c.drawText(s, x, y, p)
+    }
+
+    /** Teks yang otomatis mengecil supaya muat di [maxW]. */
+    private fun fit(c: Canvas, s: String, x: Float, y: Float, size: Float, maxW: Float, color: Int, face: Typeface, bold: Boolean, spacing: Float) {
+        val p = Paint(Paint.ANTI_ALIAS_FLAG)
+        p.typeface = Typeface.create(face, if (bold) Typeface.BOLD else Typeface.NORMAL)
+        p.letterSpacing = spacing
+        var sz = size
+        p.textSize = sz
+        while (p.measureText(s) > maxW && sz > 14f) { sz -= 2f; p.textSize = sz }
+        p.color = color
+        p.textAlign = Paint.Align.CENTER
+        c.drawText(s, x, y, p)
+    }
+}
