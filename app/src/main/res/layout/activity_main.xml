<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@drawable/bg_header">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="Bracket Live" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BRACKET"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="LIVE"
                    android:textColor="@color/cyan"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="TOURNAMENT BRACKET MANAGER"
                android:textColor="@color/muted"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGameTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text="Pilih Game"
            android:textColor="@color/on_accent"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/bg_chip_active" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@drawable/bg_neon_line" />

    <!-- Toggle overlay (di atas) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_toggle_bar">

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            app:thumbTint="@color/switch_thumb"
            app:trackTint="@color/switch_track" />

        <View
            android:id="@+id/dotOverlay"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_dot_off" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOverlayState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Overlay Nonaktif"
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Ikon B melayang di atas aplikasi lain"
                android:textColor="@color/muted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Pengaturan turnamen -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="12dp">

                <TextView style="@style/SectionLabel" android:text="TURNAMEN" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/btnGame" style="@style/SegBtn" android:text="🎮  Game" />
                    <TextView android:id="@+id/btnMode" style="@style/SegBtn" android:text="⚔  Mode" android:layout_marginEnd="0dp" />
                </LinearLayout>

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="14dp"
                    android:text="JUMLAH SLOT" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/btnSize4" style="@style/SegBtn" android:text="4" />
                    <TextView android:id="@+id/btnSize8" style="@style/SegBtn" android:text="8" />
                    <TextView android:id="@+id/btnSize16" style="@style/SegBtn" android:text="16" android:layout_marginEnd="0dp" />
                </LinearLayout>

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="14dp"
                    android:text="FORMAT MATCH" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/btnBO1" style="@style/SegBtn" android:text="BO1" />
                    <TextView android:id="@+id/btnBO3" style="@style/SegBtn" android:text="BO3" />
                    <TextView android:id="@+id/btnBO5" style="@style/SegBtn" android:text="BO5" android:layout_marginEnd="0dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Game panel -->
            <LinearLayout
                android:id="@+id/panelGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="12dp">

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginBottom="10dp"
                    android:text="PILIH GAME" />

                <GridLayout
                    android:id="@+id/gridGames"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2" />
            </LinearLayout>

            <!-- Mode panel -->
            <LinearLayout
                android:id="@+id/panelMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_card"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginBottom="10dp"
                    android:text="PILIH MODE" />

                <GridLayout
                    android:id="@+id/gridModes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2" />
            </LinearLayout>

            <!-- Team list (BR) -->
            <LinearLayout
                android:id="@+id/teamList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Bracket -->
            <HorizontalScrollView
                android:id="@+id/bracketScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/bracketContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp" />
            </HorizontalScrollView>

            <!-- Champion -->
            <LinearLayout
                android:id="@+id/champBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:background="@drawable/bg_champ"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/SectionLabel"
                    android:textColor="@color/gold"
                    android:text="🏆  JUARA" />

                <TextView
                    android:id="@+id/tvChampion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/btnCert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="Buat Sertifikat"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:background="@drawable/bg_btn_primary"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#0A0E1C">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/btnReset" style="@style/ActionBtn" android:text="Reset" android:background="@drawable/bg_btn_gray" android:textColor="@color/red"/>
            <TextView android:id="@+id/btnFill" style="@style/ActionBtn" android:text="Contoh" android:background="@drawable/bg_btn_gray" android:textColor="@color/gold"/>
            <TextView android:id="@+id/btnShuffle" style="@style/ActionBtn" android:text="Acak" android:background="@drawable/bg_btn_gray" android:textColor="@color/muted_light"/>
            <TextView android:id="@+id/btnAdd" style="@style/ActionBtn" android:text="+ Tim" android:background="@drawable/bg_btn_primary" android:textColor="#FFFFFF" android:layout_marginEnd="0dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Pilih game untuk mulai"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</LinearLayout>
