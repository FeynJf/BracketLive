<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_main">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/bg_header">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="Bracket Live" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BRACKET"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed" />

                <TextView
                    android:id="@+id/tvTitleLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:tag="skin:accent_text"
                    android:text="LIVE"
                    android:textColor="@color/text"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manajer turnamen"
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:src="@drawable/ic_settings"
            android:background="@drawable/bg_chip"
            android:contentDescription="Pengaturan" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:animateLayoutChanges="true"
            android:padding="16dp">

            <!-- Pengaturan turnamen -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/SectionLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Turnamen" />

                    <TextView
                        android:id="@+id/tvGameTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:tag="skin:chip_active"
                        android:text="Pilih game"
                        android:textColor="@color/text"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etTournament"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:background="@drawable/bg_input"
                    android:hint="Nama turnamen (tampil di atas bracket)"
                    android:inputType="textCapWords"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="@color/text"
                    android:textColorHint="@color/dim"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnGame"
                        style="@style/SegBtn"
                        android:drawableStart="@drawable/ic_ov_pad"
                        android:drawableTint="@color/muted_light"
                        android:drawablePadding="8dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Game" />

                    <TextView
                        android:id="@+id/btnMode"
                        style="@style/SegBtn"
                        android:layout_marginEnd="0dp"
                        android:drawableStart="@drawable/ic_ov_swords"
                        android:drawableTint="@color/muted_light"
                        android:drawablePadding="8dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Mode" />
                </LinearLayout>

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="16dp"
                    android:text="Jumlah slot" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/btnSize4" style="@style/SegBtn" android:text="4" />
                    <TextView android:id="@+id/btnSize8" style="@style/SegBtn" android:text="8" />
                    <TextView android:id="@+id/btnSize16" style="@style/SegBtn" android:text="16" android:layout_marginEnd="0dp" />
                </LinearLayout>

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginTop="16dp"
                    android:text="Format match" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/btnBO1" style="@style/SegBtn" android:text="BO1" />
                    <TextView android:id="@+id/btnBO3" style="@style/SegBtn" android:text="BO3" />
                    <TextView android:id="@+id/btnBO5" style="@style/SegBtn" android:text="BO5" android:layout_marginEnd="0dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Game panel -->
            <LinearLayout
                android:id="@+id/panelGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_card"
                android:layout_marginBottom="12dp">

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginBottom="10dp"
                    android:text="Pilih game" />

                <GridLayout
                    android:id="@+id/gridGames"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2" />
            </LinearLayout>

            <!-- Mode panel -->
            <LinearLayout
                android:id="@+id/panelMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_card"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <TextView
                    style="@style/SectionLabel"
                    android:layout_marginBottom="10dp"
                    android:text="Pilih mode" />

                <GridLayout
                    android:id="@+id/gridModes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2" />
            </LinearLayout>

            <!-- Kosong: sederhana dan jujur -->
            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="28dp"
                android:paddingBottom="28dp">

                <ImageView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_ov_hex"
                    android:tint="@color/muted"
                    android:background="@drawable/bg_chip"
                    android:contentDescription="Belum ada bracket" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Belum ada bracket"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Pilih game dan mode di atas, bracket langsung dibuat."
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Nama turnamen di atas bracket -->
            <TextView
                android:id="@+id/tvTournamentTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:visibility="gone" />

            <!-- Team list (BR) -->
            <LinearLayout
                android:id="@+id/teamList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:animateLayoutChanges="true"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Bracket -->
            <HorizontalScrollView
                android:id="@+id/bracketScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/bracketContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="8dp" />
            </HorizontalScrollView>

            <!-- Juara -->
            <LinearLayout
                android:id="@+id/champBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="20dp"
                android:background="@drawable/bg_card"
                android:visibility="gone"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/SectionLabel"
                    android:text="Juara" />

                <TextView
                    android:id="@+id/tvChampion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/gold"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/btnCert"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:tag="skin:primary"
                    android:text="Buat sertifikat"
                    android:textColor="@color/text"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Aksi bawah -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/btnReset" style="@style/ActionBtn" android:text="Reset" android:background="@drawable/bg_btn_gray" android:textColor="@color/red"/>
            <TextView android:id="@+id/btnFill" style="@style/ActionBtn" android:text="Contoh" android:background="@drawable/bg_btn_gray" android:textColor="@color/muted_light"/>
            <TextView android:id="@+id/btnShuffle" style="@style/ActionBtn" android:text="Acak" android:background="@drawable/bg_btn_gray" android:textColor="@color/muted_light"/>
            <TextView android:id="@+id/btnAdd" style="@style/ActionBtn" android:text="+ Tim" android:tag="skin:primary" android:textColor="@color/text" android:layout_marginEnd="0dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Pilih game untuk mulai"
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</LinearLayout>
