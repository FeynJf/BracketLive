<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#6600E5FF" android:endColor="#667C4DFF" android:angle="135"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:startColor="#121A3C" android:endColor="#0B1024" android:angle="135"/>
            <corners android:radius="17dp"/>
        </shape>
    </item>
</layer-list>
