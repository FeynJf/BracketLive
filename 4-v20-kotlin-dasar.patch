diff --git a/app/src/main/java/com/gamebracket/overlay/Fonts.kt b/app/src/main/java/com/gamebracket/overlay/Fonts.kt
new file mode 100644
index 0000000..71ca25e
--- /dev/null
+++ b/app/src/main/java/com/gamebracket/overlay/Fonts.kt
@@ -0,0 +1,188 @@
+package com.gamebracket.overlay
+
+import android.content.Context
+import android.graphics.Typeface
+import android.os.Handler
+import android.os.Looper
+import android.view.View
+import android.view.ViewGroup
+import android.widget.TextView
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URL
+import java.net.URLEncoder
+import java.util.concurrent.Executors
+
+/**
+ * Font dari katalog Google Fonts. Berkas font tidak dibundel di APK (ratusan MB), tapi diunduh
+ * sekali saat dipilih lalu disimpan di perangkat — setelah itu dipakai offline.
+ */
+object Fonts {
+
+    private const val BASE = "https://fonts.gstatic.com/s/"
+    private const val UA = "Mozilla/5.0 (Linux; U; Android 4.4.2; en-us; Nexus 5 Build/KOT49H) AppleWebKit/534.30 (KHTML, like Gecko) Version/4.0 Mobile Safari/534.30"
+
+    private val main = Handler(Looper.getMainLooper())
+    private val pool = Executors.newFixedThreadPool(2)
+    private val faces = HashMap<String, Typeface>()
+    private val pending = HashMap<String, MutableList<(Boolean) -> Unit>>()
+    private val listeners = LinkedHashMap<String, () -> Unit>()
+    private var catalog: Map<String, String>? = null
+    private val lists = HashMap<String, List<String>>()
+
+    /** Naik tiap font baru selesai diunduh (layar menyegarkan teksnya). */
+    @Volatile var version = 0
+        private set
+
+    // ───────────── daftar & katalog ─────────────
+
+    /** Daftar nama font: "ui" (700), "title" (300), "cert" (300), "sign" (20). */
+    fun list(ctx: Context, which: String): List<String> = lists.getOrPut(which) {
+        try {
+            ctx.assets.open("fontlist/$which.txt").bufferedReader().use { r -> r.readLines().filter { it.isNotBlank() } }
+        } catch (e: Exception) {
+            emptyList()
+        }
+    }
+
+    private fun catalog(ctx: Context): Map<String, String> {
+        catalog?.let { return it }
+        val m = LinkedHashMap<String, String>()
+        try {
+            for (part in listOf("catalog1.tsv", "catalog2.tsv")) {
+                ctx.assets.open("fontlist/$part").bufferedReader().use { r ->
+                    r.forEachLine { line ->
+                        val i = line.indexOf('\t')
+                        if (i > 0) m[line.substring(0, i)] = line.substring(i + 1).trim()
+                    }
+                }
+            }
+        } catch (e: Exception) {
+            CrashLog.record(ctx, "baca katalog font", e)
+        }
+        catalog = m
+        return m
+    }
+
+    // ───────────── cache & unduh ─────────────
+
+    private fun file(ctx: Context, family: String): File {
+        val slug = family.lowercase().replace(Regex("[^a-z0-9]+"), "_")
+        return File(File(ctx.filesDir, "gfonts").apply { mkdirs() }, "$slug.ttf")
+    }
+
+    /** Font yang sudah ada di perangkat (memori atau berkas). Null kalau belum diunduh. */
+    fun cached(ctx: Context, family: String): Typeface? {
+        if (family.isBlank()) return null
+        faces[family]?.let { return it }
+        val f = file(ctx, family)
+        if (!f.exists() || f.length() < 2048) return null
+        return try {
+            Typeface.createFromFile(f).also { faces[family] = it }
+        } catch (e: Exception) {
+            f.delete()
+            null
+        }
+    }
+
+    /** Pastikan font ada; unduh kalau perlu. [cb] dipanggil di main thread (true = siap dipakai). */
+    fun ensure(ctx: Context, family: String, cb: (Boolean) -> Unit = {}) {
+        if (family.isBlank()) { cb(true); return }
+        if (cached(ctx, family) != null) { cb(true); return }
+        val app = ctx.applicationContext
+        synchronized(pending) {
+            val waiting = pending[family]
+            if (waiting != null) { waiting.add(cb); return }
+            pending[family] = mutableListOf(cb)
+        }
+        pool.execute {
+            val ok = try { download(app, family) } catch (e: Exception) { CrashLog.record(app, "unduh font $family", e); false }
+            main.post {
+                if (ok) { version++; listeners.values.toList().forEach { it() } }
+                val cbs = synchronized(pending) { pending.remove(family) } ?: mutableListOf()
+                cbs.forEach { it(ok && cached(app, family) != null) }
+            }
+        }
+    }
+
+    private fun fetch(url: String, dest: File): Boolean {
+        val conn = URL(url).openConnection() as HttpURLConnection
+        try {
+            conn.connectTimeout = 12000
+            conn.readTimeout = 20000
+            conn.setRequestProperty("User-Agent", UA)
+            if (conn.responseCode != 200) return false
+            val part = File(dest.parentFile, dest.name + ".part")
+            conn.inputStream.use { i -> part.outputStream().use { o -> i.copyTo(o) } }
+            if (part.length() < 2048) { part.delete(); return false }
+            // pastikan berkasnya font yang valid sebelum dipakai
+            Typeface.createFromFile(part)
+            return part.renameTo(dest)
+        } finally {
+            conn.disconnect()
+        }
+    }
+
+    private fun download(ctx: Context, family: String): Boolean {
+        val dest = file(ctx, family)
+        val path = catalog(ctx)[family]
+        if (path != null) {
+            try { if (fetch(BASE + path, dest)) return true } catch (e: Exception) { /* coba jalur cadangan */ }
+        }
+        // cadangan: minta CSS ke Google Fonts lalu ambil URL TTF-nya
+        val css = URL("https://fonts.googleapis.com/css?family=" + URLEncoder.encode(family, "UTF-8"))
+            .openConnection().let { c ->
+                c.setRequestProperty("User-Agent", UA)
+                c.connectTimeout = 12000
+                c.readTimeout = 12000
+                c.getInputStream().bufferedReader().use { it.readText() }
+            }
+        val url = Regex("url\\((https://[^)]+\\.ttf)\\)").find(css)?.groupValues?.get(1) ?: return false
+        return fetch(url, dest)
+    }
+
+    // ───────────── pemakaian ─────────────
+
+    fun uiFace(ctx: Context): Typeface? = Prefs.uiFont(ctx).let { if (it.isEmpty()) null else cached(ctx, it) }
+    fun titleFace(ctx: Context): Typeface? = Prefs.titleFont(ctx).let { if (it.isEmpty()) null else cached(ctx, it) }
+
+    /** Unduh font pilihan yang belum ada (dipanggil saat aplikasi dibuka). */
+    fun preload(ctx: Context) {
+        listOf(Prefs.uiFont(ctx), Prefs.titleFont(ctx)).forEach { if (it.isNotEmpty()) ensure(ctx, it) }
+    }
+
+    fun addListener(key: String, fn: (() -> Unit)?) {
+        if (fn == null) listeners.remove(key) else listeners[key] = fn
+    }
+
+    /** Terapkan font aplikasi ke semua TextView di [root] (judul turnamen memakai font judulnya sendiri). */
+    fun apply(root: View) {
+        val ctx = root.context
+        val ui = uiFace(ctx)
+        val title = titleFace(ctx)
+        if (ui == null && title == null) return
+        walk(root, ctx, ui, title)
+    }
+
+    private fun walk(v: View, ctx: Context, ui: Typeface?, title: Typeface?) {
+        if (v is TextView) {
+            val role = v.getTag(R.id.font_role) as? String
+            val face = when (role) {
+                "keep" -> null
+                "title" -> title ?: ui
+                else -> ui
+            }
+            if (face != null && v.getTag(R.id.font_key) != face) {
+                v.setTypeface(face, v.typeface?.style ?: Typeface.NORMAL)
+                v.setTag(R.id.font_key, face)
+            }
+        }
+        if (v is ViewGroup) for (i in 0 until v.childCount) walk(v.getChildAt(i), ctx, ui, title)
+    }
+
+    /** Tandai TextView agar font aplikasi tidak menimpanya (mis. pratinjau font). */
+    fun markKeep(v: TextView) { v.setTag(R.id.font_role, "keep") }
+
+    /** Tandai TextView sebagai judul turnamen (memakai font & gaya judul). */
+    fun markTitle(v: TextView) { v.setTag(R.id.font_role, "title") }
+}
diff --git a/app/src/main/java/com/gamebracket/overlay/ListPicker.kt b/app/src/main/java/com/gamebracket/overlay/ListPicker.kt
new file mode 100644
index 0000000..5db9f19
--- /dev/null
+++ b/app/src/main/java/com/gamebracket/overlay/ListPicker.kt
@@ -0,0 +1,147 @@
+package com.gamebracket.overlay
+
+import android.app.Activity
+import android.graphics.Typeface
+import android.graphics.drawable.GradientDrawable
+import android.text.Editable
+import android.text.TextWatcher
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.BaseAdapter
+import android.widget.EditText
+import android.widget.LinearLayout
+import android.widget.ListView
+import android.widget.TextView
+import androidx.core.content.ContextCompat
+
+/** Satu baris pilihan: judul, keterangan, titik warna (opsional), dan font untuk pratinjau (opsional). */
+class PickRow(val title: String, val sub: String? = null, val dots: IntArray? = null, val face: () -> Typeface? = { null })
+
+/** Dialog daftar dengan pencarian (dipakai untuk font, desain sertifikat, tema warna, dll). */
+object ListPicker {
+
+    /**
+     * @param confirm true = ketuk baris hanya memilih (pratinjau), lalu tombol Terapkan menetapkan.
+     * @param preview teks contoh yang tampil di atas daftar (untuk pratinjau font); [onPreview] dipanggil tiap baris dipilih.
+     */
+    fun show(
+        act: Activity, title: String, subtitle: String, rows: List<PickRow>, selected: Int,
+        confirm: Boolean = false, preview: String? = null,
+        onPreview: ((Int, TextView) -> Unit)? = null, onPick: (Int) -> Unit
+    ) {
+        val d0 = act.resources.displayMetrics.density
+        fun dp(v: Int) = (v * d0).toInt()
+        val dlg = PremiumDialog(act).title(title, subtitle)
+        var current = selected
+        var shown: List<Int> = rows.indices.toList()
+
+        var previewView: TextView? = null
+        if (preview != null) {
+            previewView = TextView(act).apply {
+                text = preview
+                textSize = 20f
+                gravity = Gravity.CENTER
+                setTextColor(ContextCompat.getColor(act, R.color.text))
+                setPadding(dp(12), dp(14), dp(12), dp(14))
+                background = Skin.chip(act)
+            }
+            Fonts.markKeep(previewView)
+            dlg.body.addView(previewView, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply { bottomMargin = dp(10) })
+            if (current in rows.indices) onPreview?.invoke(current, previewView)
+        }
+
+        val search = EditText(act).apply {
+            hint = "Cari (${rows.size})"
+            setHintTextColor(ContextCompat.getColor(act, R.color.dim))
+            setTextColor(ContextCompat.getColor(act, R.color.text))
+            textSize = 14f
+            setSingleLine()
+            setPadding(dp(14), 0, dp(14), 0)
+            setBackgroundResource(R.drawable.bg_input)
+        }
+        dlg.body.addView(search, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(44)))
+
+        val list = ListView(act).apply {
+            divider = null
+            isVerticalScrollBarEnabled = false
+            overScrollMode = View.OVER_SCROLL_NEVER
+        }
+        val adapter = object : BaseAdapter() {
+            override fun getCount() = shown.size
+            override fun getItem(p: Int) = rows[shown[p]]
+            override fun getItemId(p: Int) = shown[p].toLong()
+            override fun getView(p: Int, convert: View?, parent: ViewGroup?): View {
+                val idx = shown[p]
+                val row = rows[idx]
+                val sel = idx == current
+                val box = LinearLayout(act).apply {
+                    orientation = LinearLayout.HORIZONTAL
+                    gravity = Gravity.CENTER_VERTICAL
+                    setPadding(dp(12), dp(10), dp(12), dp(10))
+                    background = if (sel) Skin.rect(act, ThemeManager.withAlpha(Skin.accent(act), 38), 8f, Skin.accent(act), 1.5f) else null
+                }
+                row.dots?.forEach { c ->
+                    box.addView(View(act).apply {
+                        background = GradientDrawable().apply { shape = GradientDrawable.OVAL; setColor(c); setStroke(dp(1), 0x44FFFFFF) }
+                        layoutParams = LinearLayout.LayoutParams(dp(16), dp(16)).apply { marginEnd = dp(5) }
+                    })
+                }
+                val col = LinearLayout(act).apply {
+                    orientation = LinearLayout.VERTICAL
+                    layoutParams = LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f).apply { if (row.dots != null) marginStart = dp(6) }
+                }
+                col.addView(TextView(act).apply {
+                    text = row.title
+                    textSize = 15f
+                    setTextColor(ContextCompat.getColor(act, if (sel) R.color.text else R.color.muted_light))
+                    if (sel) setTypeface(typeface, Typeface.BOLD)
+                    row.face()?.let { f -> setTypeface(f, if (sel) Typeface.BOLD else Typeface.NORMAL); Fonts.markKeep(this) }
+                })
+                if (row.sub != null) col.addView(TextView(act).apply {
+                    text = row.sub
+                    textSize = 11f
+                    setTextColor(ContextCompat.getColor(act, R.color.muted))
+                })
+                box.addView(col)
+                if (sel) box.addView(View(act).apply {
+                    background = Skin.rect(act, Skin.accent(act), 4f)
+                    layoutParams = LinearLayout.LayoutParams(dp(8), dp(8))
+                })
+                return box
+            }
+        }
+        list.adapter = adapter
+        list.setOnItemClickListener { _, _, p, _ ->
+            val idx = shown[p]
+            if (confirm) {
+                current = idx
+                adapter.notifyDataSetChanged()
+                previewView?.let { onPreview?.invoke(idx, it) }
+            } else {
+                dlg.dismiss()
+                onPick(idx)
+            }
+        }
+        search.addTextChangedListener(object : TextWatcher {
+            override fun beforeTextChanged(s: CharSequence?, a: Int, b: Int, c: Int) {}
+            override fun onTextChanged(s: CharSequence?, a: Int, b: Int, c: Int) {}
+            override fun afterTextChanged(s: Editable?) {
+                val q = s?.toString()?.trim()?.lowercase() ?: ""
+                shown = if (q.isEmpty()) rows.indices.toList() else rows.indices.filter { rows[it].title.lowercase().contains(q) }
+                adapter.notifyDataSetChanged()
+            }
+        })
+        val maxH = minOf(dp(320), (act.resources.displayMetrics.heightPixels * 0.42f).toInt())
+        dlg.body.addView(list, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, maxH).apply { topMargin = dp(8) })
+
+        if (confirm) {
+            dlg.primary("Terapkan") { onPick(current); true }
+            dlg.secondary("Batal")
+        } else {
+            dlg.secondary("Tutup")
+        }
+        dlg.show()
+        if (current > 3) list.post { list.setSelection(maxOf(0, current - 2)) }
+    }
+}
